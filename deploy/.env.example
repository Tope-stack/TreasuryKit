# Copy to .env on the server and fill in. Never commit .env.

# Public address Caddy serves and gets a certificate for: a domain pointed at the VM,
# or a free name derived from the VM's IP, e.g. 203-0-113-5.sslip.io
SITE_ADDRESS=demo.example.com

# Shared password gate in front of the whole site.
# Hash:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains '$' characters.
BASIC_AUTH_USER=demo
BASIC_AUTH_HASH='$2a$14$replace.with.output.of.caddy.hash-password'

# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SIGNING_KEY=

# Images: ghcr.io/<owner>/treasurykit-api and -worker. TAG=latest, or a commit SHA to pin/roll back.
IMAGE_PREFIX=ghcr.io/tope-stack/treasurykit
TAG=latest

# Days of nightly database backups to keep.
BACKUP_KEEP_DAYS=7
