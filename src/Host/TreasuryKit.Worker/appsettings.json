{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Outbox": {
    "PollingInterval": "00:00:02",
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "FileStore": {
    "RootPath": "../../../.data/files"
  },
  "Jobs": {
    "PollingInterval": "00:00:01",
    "Lease": "00:10:00",
    "BatchSize": 5
  }
}
